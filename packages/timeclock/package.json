{
  "name": "@carbon/timeclock",
  "dependencies": {
    "@carbon/database": "workspace:*",
    "@carbon/logger": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "ws": "8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@carbon/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
